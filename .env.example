# Kopiér til .env og udfyld. Rigtige nøgler må ALDRIG committes.
# Variabler markeret (Mx) bliver påkrævede i den pågældende milestone.

# App
APP_ENV=local                       # local | preview | staging | production
LOG_LEVEL=info
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=local

# Database (påkrævet)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carrental
# Separat database til integrationstests (tømmes af testene)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carrental_test

# Fejlmonitorering (valgfri lokalt)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Auth (M3) — generér med: openssl rand -base64 32
AUTH_SECRET=
FIELD_ENCRYPTION_KEY=

# Cron-beskyttelse (M7)
CRON_SECRET=

# Betaling / Stripe (M7) — svarer til PAYMENT_SECRET i kravspecifikationen
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# E-mail (M8)
EMAIL_API_KEY=
EMAIL_FROM=

# WhatsApp (M8)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Kort (M6)
MAPS_API_KEY=
NEXT_PUBLIC_MAPS_EMBED_KEY=

# Fil-storage (M11)
STORAGE_ENDPOINT=
STORAGE_BUCKET_PRIVATE=
STORAGE_BUCKET_PUBLIC=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Rate limiting (M3)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
